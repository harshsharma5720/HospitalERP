# Settings for docker-compose.yml. Copy to .env (same folder) and fill in:
#   cp .env.docker.example .env
# .env is git-ignored — never commit it.

# ---------- required ----------
# MySQL root password and the app's own database user (created automatically on first start)
DB_ROOT_PASSWORD=change-me-root
DB_USERNAME=hospital
DB_PASSWORD=change-me-app

# Base64 secret, at least 32 bytes: openssl rand -base64 48
# Empty = a random key per start (everyone is logged out on every restart)
JWT_SECRET=

# First admin account, created once at startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_EMAIL=admin@hospital.com

# ---------- ports on your machine ----------
FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3307

# ---------- optional ----------
# Phone verification on sign-up needs Twilio; off by default in Docker
OTP_REQUIRED=false
# Day-before appointment reminders (SMS + email)
REMINDERS_ENABLED=true

# Email (SMTP) — without it emails are skipped
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# SMS (Twilio) — without it SMS are skipped
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TRIAL_NUMBER=

# Prescription PDF letterhead
HOSPITAL_NAME=Hospital ERP
HOSPITAL_ADDRESS=
HOSPITAL_PHONE=
