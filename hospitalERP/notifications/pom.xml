<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.itmonteur.hospitalerp</groupId>
		<artifactId>hospital-erp</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>hospital-notifications</artifactId>
	<name>hospital-notifications</name>
	<description>Delivery channels: email, SMS (Twilio), message templates and the outbox that retries undelivered messages. Knows nothing about appointments.</description>

	<!-- The modules this one may use (docs/MULTI_MODULE_PLAN.md §2.1). Modules above it are not on its classpath at all;
	     tools/check_module_deps.py also flags a lower module that is only reachable transitively. -->
	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>hospital-common</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<!-- The outbox of undelivered messages (docs/RELIABLE_NOTIFICATIONS_PLAN.md) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>
		<dependency>
			<groupId>com.twilio.sdk</groupId>
			<artifactId>twilio</artifactId>
		</dependency>
	</dependencies>
</project>
